PORT=3002

# Required for onboard-film.js (new-film onboarding pipeline). Free, register at
# themoviedb.org/settings/api — provides genres, budget, worldwide revenue,
# cast/crew. Non-commercial use is free; commercial use needs a separate paid
# license. Use the Read Access Token (the long one), not the short API Key —
# TMDb's own recommended auth method, sent as "Authorization: Bearer <token>".
TMDB_ACCESS_TOKEN=

# Required for onboard-film.js. Free tier (1,000 req/day), register at
# omdbapi.com — provides the Metascore (Metacritic's own critic score) and
# domestic box office total. CC BY-NC 4.0 — NON-COMMERCIAL USE ONLY. Revisit
# this source if Kernel is ever monetized.
OMDB_API_KEY=

# Optional. Enables the audience-review AI synopsis (GET /api/synopsis/:dataId).
# Without it, that endpoint returns { status: "unconfigured" } and the widget
# shows an honest "not configured" message instead of a synopsis.
ANTHROPIC_API_KEY=

# Optional. Overrides which .db file this connects to — used by npm run
# start:dev / seed:dev / seed:batch2:dev (via dev-env.js) to point at
# kernel.dev.db instead of the real kernel.db, so testing (audience reviews,
# tamper tests, etc.) never touches production data. Leave unset for normal
# use — defaults to kernel.db.
DB_PATH=

# Required. This is what makes the log's hash chain unforgeable — anyone with
# read access to this codebase can see the *algorithm*, but without this key
# they can't recompute valid row hashes, so tampering with data_log (whether
# through the DB file directly or a compromised app instance) is detectable.
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it out of source control and out of the database itself.
HMAC_SECRET=
