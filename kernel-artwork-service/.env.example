PORT=3001

# TMDb Read Access Token (the long one, not the short "API Key") —
# https://www.themoviedb.org/settings/api — this is TMDb's own recommended
# auth method, sent as "Authorization: Bearer <token>".
TMDB_ACCESS_TOKEN=

# OMDb API key — https://www.omdbapi.com/apikey.aspx
# Only used as a fallback when TMDb has no poster for a title.
# Check OMDb's commercial-use terms before relying on this in production
# if Kernel is beyond personal/free-tier use.
OMDB_API_KEY=
